/target
**/*.rs.bk
.idea/
.vscode/

# Fetched blobs — hashes live in git, bytes do not.
/corpora/data/
/third_party/zstd/*.zip
/third_party/zstd/extracted/

# Local bench scratch
/bench/tmp/
*.zst

# Great Gate -- private content-adaptive-dispatch campaign (docs + gate
# calculator). Local-only, never published. Same policy as remade_ffmpeg_rs.
# The docs/plans/gg-*.md plans were stripped from history before the repo went
# public; keep them out.
/_greatgate/
/docs/plans/gg-*.md

# `rustc scripts/cpuprobe.rs` drops its binary wherever it is run from.
/cpuprobe.exe
/cpuprobe.pdb

# The bare-metal firmware builds into its own target dir (it is not a
# workspace member, so the root /target rule does not cover it).
bare-metal/*/target/

# Local-only cargo config (the path form of the rusty_json_turbo patch,
# used to validate against an unpushed checkout). Never committed: a patch
# the CI runner cannot resolve breaks every build there.
/.cargo/config.toml
